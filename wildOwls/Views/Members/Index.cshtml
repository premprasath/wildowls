@model List<WildOwls.Model.GroupInfo>

@{
    ViewData["Title"] = "Add/Update-Members";
}

@section scripts{
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.5/css/responsive.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.5/js/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.22.2/moment.min.js"></script>
    <script src="~/lib/jquery/dist/jquery-unobtrusive-ajax.min.js"></script>
    <script src="~/js/members-index.js" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Owl Page</title>
    <style>
        body {
            background-color: #e0f7fa; /* light blue */
            font-family: Arial, sans-serif;
            height: 100%;
            width: 100%;
        }

        .content {
            padding: 40px;
        }

        .group1 {
            background-color: #ffcccb;
        }

        .group2 {
            background-color: #add8e6;
        }

        .group3 {
            background-color: #90ee90;
        }

        .center {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 40%;
        }
    </style>
</head>
</html>

<div class="form-group pt-3 col-md-12 text-danger" style="width:100%; text-align: center; word-break: break-word;">
    <div id="errorId">
        <h6>@Html.Raw(ViewBag.MessageId)</h6>
    </div>
    <div id="errorMessage">
        <h5>@ViewBag.Error</h5>
    </div>
</div>


<form method="post" id="MembersDashboard">
    <div class="form-group" style="width:100%">
        <div class="form-group col-md-12 text-danger" style="width:100%; text-align: center; word-break: break-word;">
            <div id="errorId">
                <h6>@Html.Raw(ViewBag.MessageId)</h6>
            </div>
            <div id="errorMessage">
                <h5>@ViewBag.Error</h5>
            </div>
        </div>

        <div class="card" style="background-color: transparent; border:none;">
            <div class="card-body" style="padding-top:0%; max-width:100%">
                <img src="NamathuKudumbam1.jpg" alt="image" class="center" />
                <h4>GroupInfo</h4>
                <table class="table" id="groupGrid"></table>
                <table class="table" id="membersGrid"></table>
            </div>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal">
            Add Members
        </button>
    </div>
</form>

<div class="form-group" style="width:100%">
    <h2>Meeting Videos</h2>
    <video width="740" height="580" controls>
        <source src="~/owl4.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    <video width="740" height="580" controls>
        <source src="~/owl3.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    <video width="740" height="580" controls>
        <source src="~/owl2.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    <video width="740" height="580" controls>
        <source src="~/owl1.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
</div>

    <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Members" asp-action="AddMember" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="userModalLabel">Member Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="GroupId">GroupId</label>
                            <select id="code" name="GroupId" class="form-control">
                                <option value="G001">G001</option>
                                <option value="G002">G002</option>
                                <option value="G003">G003</option>
                                <option value="G004">G004</option>
                                <option value="G005">G005</option>
                                <option value="G006">G006</option>
                                <option value="G007">G007</option>
                                <option value="G008">G008</option>
                                <option value="G009">G009</option>
                                <option value="G010">G010</option>
                                <option value="G010">G011</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="MemberName" class="form-label">Name</label>
                            <input name="MemberName" type="text" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="Phone" class="form-label">Phone Number</label>
                            <input name="Phone" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="BirthDate" class="form-label">Birth Date</label>
                            <input name="BirthDate" type="datetime-local" asp-format="{0:dd-MM-yyyy}" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="Address" class="form-label">Address</label>
                            <input name="Address" type="text" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save Data</button>
                        <button type="reset" class="btn btn-warning">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <div class="modal fade" id="familyModal" tabindex="-1" aria-labelledby="familyModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Members" asp-action="AddMember" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="familyModalLabel">Family Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="familyId" name="FamilyId" />
                        <input type="hidden" id="groupId" name="GroupId" />
                        <input type="hidden" id="isAdditional" name="IsAdditional" />
                        <input type="hidden" id="isEdit" name="IsEdit" />
                        <input type="hidden" id="memberId" name="MemberId" />


                        <div class="mb-3">
                            <label for="WifeName" class="form-label">Wife Name</label>
                            <input name="WifeName" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="AdditionalMember" class="form-label">Additional Name</label>
                            <input name="AdditionalMember" id="memberName" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="Phone" class="form-label">Phone Number</label>
                            <input name="Phone" id="phone" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="BirthDate" class="form-label">Birth Date</label>
                            <input name="BirthDate" type="datetime-local" asp-format="{0:dd-MM-yyyy}" id="birthDate" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="MarriageDate" class="form-label">Marriage Date</label>
                            <input name="MarriageDate" id="marriageDate" type="datetime-local" asp-format="{0:dd-MM-yyyy}" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="AmountPaid" class="form-label">AmountPaid</label>
                            <input name="AmountPaid" id="amountPaid" type="number" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="Address" class="form-label">Address</label>
                            <input name="Address" id="address" type="text" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save Data</button>
                        <button type="reset" class="btn btn-warning">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
